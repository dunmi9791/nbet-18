<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_nbet_niso" model="ir.module.category">
        <field name="name">NBET NISO</field>
        <field name="description">NISO Advice and Receipt Management</field>
        <field name="sequence">27</field>
    </record>

    <record id="group_niso_user" model="res.groups">
        <field name="name">NISO Officer</field>
        <field name="category_id" ref="module_category_nbet_niso"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can record NISO advices and capture receipts against them.</field>
    </record>

    <record id="group_niso_manager" model="res.groups">
        <field name="name">NISO Manager</field>
        <field name="category_id" ref="module_category_nbet_niso"/>
        <field name="implied_ids" eval="[(4, ref('group_niso_user'))]"/>
        <field name="comment">Can confirm advices, post receipts and cancel NISO records.</field>
    </record>

    <!-- Sequences -->
    <record id="seq_niso_advice" model="ir.sequence">
        <field name="name">NISO Advice</field>
        <field name="code">nbet.niso.advice</field>
        <field name="prefix">NAD/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_niso_receipt" model="ir.sequence">
        <field name="name">NISO Receipt</field>
        <field name="code">nbet.niso.receipt</field>
        <field name="prefix">NRC/%(year)s/</field>
        <field name="padding">5</field>
    </record>

</odoo>
