<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_payment_voucher_form_payroll" model="ir.ui.view">
        <field name="name">nbet.payment.voucher.form.payroll</field>
        <field name="model">nbet.payment.voucher</field>
        <field name="inherit_id" ref="nbet_treasury.view_payment_voucher_form"/>
        <field name="arch" type="xml">
            <field name="tax_line_id" position="after">
                <field name="payslip_run_id" invisible="voucher_type not in ('payroll', 'tax') or not payslip_run_id"/>
                <field name="payslip_id" invisible="voucher_type != 'payroll'"/>
                <field name="employee_id" invisible="voucher_type != 'payroll'"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payslip" type="object"
                        class="oe_stat_button" icon="fa-book"
                        invisible="not payslip_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Payslip</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_payment_voucher_list_payroll" model="ir.ui.view">
        <field name="name">nbet.payment.voucher.list.payroll</field>
        <field name="model">nbet.payment.voucher</field>
        <field name="inherit_id" ref="nbet_treasury.view_payment_voucher_list"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="employee_id" optional="hide"/>
                <field name="payslip_run_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>
