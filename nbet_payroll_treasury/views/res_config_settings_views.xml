<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_payroll_treasury" model="ir.ui.view">
        <field name="name">res.config.settings.form.nbet.payroll.treasury</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='hr_payroll_accountant']" position="inside">
                <setting id="nbet_salary_payable_setting"
                         string="Salary Payable Account"
                         help="Account the salary payment vouchers clear when treasury pays a payroll batch. Leave empty to use the credit account of each payslip's NET rule.">
                    <field name="nbet_salary_payable_account_id"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
