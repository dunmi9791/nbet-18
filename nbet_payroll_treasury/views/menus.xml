              parent="nbet_treasury.menu_treasury_operations"
              action="action_payroll_batch_md_approval"
              groups="nbet_payroll_treasury.group_payroll_md"
              sequence="5"/>

    <menuitem id="menu_payroll_batches_treasury"
              name="Payroll Batches"
              parent="nbet_treasury.menu_treasury_operations"
