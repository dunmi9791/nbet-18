<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_view_form_inherit_grade" model="ir.ui.view">
        <field name="name">hr.contract.form.grade</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='wage']" position="before">
                <field name="grade_id"/>
                <field name="grade_step_id"/>
            </xpath>
            <xpath expr="//field[@name='wage']" position="after">
                <button name="action_sync_wage_from_grade" type="object"
                        string="Sync from Grade" class="btn-link"
                        title="Update wage to match the employee's current grade/step salary"
                        invisible="not grade_step_id"/>
            </xpath>
        </field>
    </record>

</odoo>
