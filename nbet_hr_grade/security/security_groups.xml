<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_hr_grade" model="ir.module.category">
        <field name="name">Grade &amp; Step Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_hr_grade_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category_hr_grade"/>
        <field name="implied_ids" eval="[(4, ref('hr.group_hr_user'))]"/>
    </record>

    <record id="group_hr_grade_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hr_grade"/>
        <field name="implied_ids" eval="[(4, ref('group_hr_grade_user'))]"/>
    </record>
</odoo>
