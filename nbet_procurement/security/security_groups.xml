<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_nbet_procurement" model="ir.module.category">
        <field name="name">NBET Procurement</field>
        <field name="description">NBET Procurement Management</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_procurement_submitter" model="res.groups">
        <field name="name">Department Submitter</field>
        <field name="category_id" ref="module_category_nbet_procurement"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Department head/focal person. Can submit and manage their own department's procurement needs against an open Needs Call.</field>
    </record>

    <record id="group_procurement_user" model="res.groups">
        <field name="name">Procurement Officer</field>
        <field name="category_id" ref="module_category_nbet_procurement"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create and manage procurement plans, needs assessments, and bid evaluations.</field>
    </record>

    <record id="group_procurement_head" model="res.groups">
        <field name="name">Head of Procurement</field>
        <field name="category_id" ref="module_category_nbet_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="comment">PPC Secretary. Can approve plans and manage all procurement activities.</field>
    </record>

    <record id="group_procurement_approver" model="res.groups">
        <field name="name">Procurement Approver (MD/PTB)</field>
        <field name="category_id" ref="module_category_nbet_procurement"/>
        <field name="implied_ids" eval="[(4, ref('group_procurement_head'))]"/>
        <field name="comment">MD/CEO or PTB member. Can approve procurement plans and contract awards.</field>
    </record>

    <!-- Record Rules.

         Odoo OR-s record rules across the groups a user belongs to, but only
         among the groups that actually carry a rule for the model: a group with
         no rule adds nothing rather than granting everything. So every model
         with a department-scoped submitter rule below needs a matching
         see-everything rule on group_procurement_user, otherwise a Procurement
         Officer/Head who is also a Department Submitter is silently narrowed
         down to their own department. group_procurement_head and
         group_procurement_approver both imply group_procurement_user; the
         submitter group does not. -->
    <record id="rule_needs_assessment_officer" model="ir.rule">
        <field name="name">Procurement Officer: all needs assessments</field>
        <field name="model_id" ref="model_nbet_needs_assessment"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_needs_assessment_line_officer" model="ir.rule">
        <field name="name">Procurement Officer: all needs assessment lines</field>
        <field name="model_id" ref="model_nbet_needs_assessment_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_procurement_plan_officer" model="ir.rule">
        <field name="name">Procurement Officer: all procurement plans</field>
        <field name="model_id" ref="model_nbet_procurement_plan"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_procurement_plan_line_officer" model="ir.rule">
        <field name="name">Procurement Officer: all plan items</field>
        <field name="model_id" ref="model_nbet_procurement_plan_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_procurement_request_officer" model="ir.rule">
        <field name="name">Procurement Officer: all procurement requests</field>
        <field name="model_id" ref="model_nbet_procurement_request"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_procurement_request_line_officer" model="ir.rule">
        <field name="name">Procurement Officer: all procurement request lines</field>
        <field name="model_id" ref="model_nbet_procurement_request_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_bid_evaluation_officer" model="ir.rule">
        <field name="name">Procurement Officer: all bid evaluations</field>
        <field name="model_id" ref="model_nbet_bid_evaluation"/>
        <field name="groups" eval="[(4, ref('group_procurement_user'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Record Rules: department submitters only see/edit their own department's needs -->
    <record id="rule_needs_assessment_submitter" model="ir.rule">
        <field name="name">Department Submitter: own department needs assessments</field>
        <field name="model_id" ref="model_nbet_needs_assessment"/>
        <field name="groups" eval="[(4, ref('group_procurement_submitter'))]"/>
        <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('department_id.member_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_needs_assessment_line_submitter" model="ir.rule">
        <field name="name">Department Submitter: own department needs lines</field>
        <field name="model_id" ref="model_nbet_needs_assessment_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_submitter'))]"/>
        <field name="domain_force">['|', ('assessment_id.department_id.manager_id.user_id', '=', user.id), ('assessment_id.department_id.member_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rule_procurement_request_submitter" model="ir.rule">
        <field name="name">Department Submitter: own department procurement requests</field>
        <field name="model_id" ref="model_nbet_procurement_request"/>
        <field name="groups" eval="[(4, ref('group_procurement_submitter'))]"/>
        <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('department_id.member_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_procurement_request_line_submitter" model="ir.rule">
        <field name="name">Department Submitter: own department request lines</field>
        <field name="model_id" ref="model_nbet_procurement_request_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_submitter'))]"/>
        <field name="domain_force">['|', ('request_id.department_id.manager_id.user_id', '=', user.id), ('request_id.department_id.member_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Departments only see procurement plan items assigned to them, and only
         the plans that carry at least one of their items. -->
    <record id="rule_procurement_plan_line_submitter" model="ir.rule">
        <field name="name">Department Submitter: own department plan items</field>
        <field name="model_id" ref="model_nbet_procurement_plan_line"/>
        <field name="groups" eval="[(4, ref('group_procurement_submitter'))]"/>
        <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('department_id.member_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_procurement_plan_submitter" model="ir.rule">
        <field name="name">Department Submitter: plans carrying own department items</field>
        <field name="model_id" ref="model_nbet_procurement_plan"/>
        <field name="groups" eval="[(4, ref('group_procurement_submitter'))]"/>
        <field name="domain_force">['|', ('line_ids.department_id.manager_id.user_id', '=', user.id), ('line_ids.department_id.member_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Submitters may follow the tender raised off their own request, but the
         bids themselves stay with Procurement (no access to the bid lines). -->
    <record id="rule_bid_evaluation_submitter" model="ir.rule">
        <field name="name">Department Submitter: own department bid evaluations</field>
        <field name="model_id" ref="model_nbet_bid_evaluation"/>
        <field name="groups" eval="[(4, ref('group_procurement_submitter'))]"/>
        <field name="domain_force">['|', ('department_id.manager_id.user_id', '=', user.id), ('department_id.member_ids.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Sequences -->
    <record id="seq_needs_call" model="ir.sequence">
        <field name="name">Needs Call</field>
        <field name="code">nbet.needs.call</field>
        <field name="prefix">NC/%(year)s/</field>
        <field name="padding">3</field>
    </record>

    <record id="seq_needs_assessment" model="ir.sequence">
        <field name="name">Needs Assessment</field>
        <field name="code">nbet.needs.assessment</field>
        <field name="prefix">NA/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_procurement_plan" model="ir.sequence">
        <field name="name">Procurement Plan</field>
        <field name="code">nbet.procurement.plan</field>
        <field name="prefix">PP/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_procurement_request" model="ir.sequence">
        <field name="name">Procurement Request</field>
        <field name="code">nbet.procurement.request</field>
        <field name="prefix">PRQ/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_bid_evaluation" model="ir.sequence">
        <field name="name">Bid Evaluation</field>
        <field name="code">nbet.bid.evaluation</field>
        <field name="prefix">BID/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_contract_award" model="ir.sequence">
        <field name="name">Contract Award</field>
        <field name="code">nbet.contract.award</field>
        <field name="prefix">CA/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_contract_milestone" model="ir.sequence">
        <field name="name">Contract Milestone</field>
        <field name="code">nbet.contract.milestone</field>
        <field name="prefix">MS/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_payment_request" model="ir.sequence">
        <field name="name">Payment Request</field>
        <field name="code">nbet.payment.request</field>
        <field name="prefix">PR/%(year)s/</field>
        <field name="padding">4</field>
    </record>

</odoo>
