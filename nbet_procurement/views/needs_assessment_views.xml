<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Needs Assessment Form -->
    <record id="view_needs_assessment_form" model="ir.ui.view">
        <field name="name">nbet.needs.assessment.form</field>
        <field name="model">nbet.needs.assessment</field>
        <field name="arch" type="xml">
            <form string="Needs Assessment">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" string="Mark Reviewed" type="object"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="nbet_procurement.group_procurement_head"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'reviewed'"
                            groups="nbet_procurement.group_procurement_approver"/>
                    <button name="action_reject" string="Reject" type="object"
                            class="btn-danger" invisible="state not in ('submitted', 'reviewed')"
                            groups="nbet_procurement.group_procurement_head"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('rejected',)"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,reviewed,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fiscal_year"/>
                            <field name="date"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="requested_by"/>
                            <field name="budget_allocation" widget="monetary"/>
                            <field name="total_estimated" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Needs" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="product_id"/>
                                    <field name="category"/>
                                    <field name="quantity"/>
                                    <field name="estimated_unit_cost" widget="monetary"/>
                                    <field name="estimated_cost" widget="monetary"/>
                                    <field name="priority"/>
                                    <field name="justification" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Needs Assessment List -->
    <record id="view_needs_assessment_list" model="ir.ui.view">
        <field name="name">nbet.needs.assessment.list</field>
        <field name="model">nbet.needs.assessment</field>
        <field name="arch" type="xml">
            <list string="Needs Assessments"
                  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="department_id"/>
                <field name="requested_by"/>
                <field name="date"/>
                <field name="total_estimated" widget="monetary"/>
                <field name="budget_allocation" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <!-- Needs Assessment Search -->
    <record id="view_needs_assessment_search" model="ir.ui.view">
        <field name="name">nbet.needs.assessment.search</field>
        <field name="model">nbet.needs.assessment</field>
        <field name="arch" type="xml">
            <search string="Search Needs Assessments">
                <field name="name"/>
                <field name="fiscal_year"/>
                <field name="department_id"/>
                <field name="requested_by"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_fiscal_year" string="Fiscal Year" context="{'group_by': 'fiscal_year'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Needs Assessment Action -->
    <record id="action_needs_assessment" model="ir.actions.act_window">
        <field name="name">Needs Assessments</field>
        <field name="res_model">nbet.needs.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Needs Assessment</p>
            <p>Collate departmental needs and budget allocations as per SOP Step 1.</p>
        </field>
    </record>

</odoo>
