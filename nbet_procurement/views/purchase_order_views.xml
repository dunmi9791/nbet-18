<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend Purchase Order Form -->
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.form.nbet.procurement</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add NBET approval buttons in header -->
            <xpath expr="//header" position="inside">
                <button name="%(action_submit_approval_wizard)d" string="Submit for NBET Approval"
                        type="action" class="btn-warning"
                        invisible="nbet_approval_state != 'pending' or not nbet_procurement_category"/>
                <button name="action_nbet_approve" string="NBET Approve" type="object"
                        class="btn-success"
                        invisible="nbet_approval_state != 'pending' or not nbet_procurement_category"
                        groups="nbet_procurement.group_procurement_approver"/>
                <button name="action_nbet_reject" string="NBET Reject" type="object"
                        class="btn-danger"
                        invisible="nbet_approval_state != 'pending' or not nbet_procurement_category"
                        groups="nbet_procurement.group_procurement_approver"/>
            </xpath>

            <!-- Add NBET Procurement tab in notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="NBET Procurement" name="nbet_procurement">
                    <group>
                        <group string="Procurement Details">
                            <field name="nbet_procurement_category"/>
                            <field name="nbet_procurement_method"/>
                            <field name="nbet_approval_authority"/>
                            <field name="nbet_contract_award_id"/>
                            <field name="nbet_bid_evaluation_id"/>
                        </group>
                        <group string="Approval Status">
                            <field name="nbet_approval_state" widget="badge"
                                   decoration-warning="nbet_approval_state == 'pending'"
                                   decoration-success="nbet_approval_state == 'approved'"
                                   decoration-danger="nbet_approval_state == 'rejected'"/>
                            <field name="nbet_approved_by"/>
                            <field name="nbet_approval_date"/>
                        </group>
                    </group>
                    <group string="Terms of Reference">
                        <field name="nbet_terms_of_reference" nolabel="1"/>
                    </group>
                    <group string="Inspection/Verification" invisible="state != 'purchase'">
                        <group>
                            <field name="nbet_inspection_done"/>
                            <field name="nbet_inspection_date"/>
                        </group>
                        <group>
                            <button name="action_mark_inspected" string="Mark as Inspected"
                                    type="object" class="btn-primary"
                                    invisible="nbet_inspection_done"/>
                        </group>
                        <field name="nbet_inspection_notes" nolabel="1"
                               placeholder="Enter inspection notes..."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend Purchase Order List -->
    <record id="view_purchase_order_list_inherit" model="ir.ui.view">
        <field name="name">purchase.order.list.nbet.procurement</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="nbet_procurement_category" optional="hide"/>
                <field name="nbet_approval_state" optional="show" widget="badge"
                       decoration-warning="nbet_approval_state == 'pending'"
                       decoration-success="nbet_approval_state == 'approved'"
                       decoration-danger="nbet_approval_state == 'rejected'"/>
            </xpath>
        </field>
    </record>

</odoo>
