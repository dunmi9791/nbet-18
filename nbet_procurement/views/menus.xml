<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone root menu (top-level app) -->
    <menuitem id="menu_nbet_procurement_root"
              name="Procurement"
              action="action_procurement_dashboard"
              web_icon="nbet_procurement,static/description/icon.png"
              sequence="45"/>

    <!-- Dashboard -->
    <menuitem id="menu_procurement_dashboard"
              name="Dashboard"
              parent="menu_nbet_procurement_root"
              action="action_procurement_dashboard"
              sequence="1"/>

    <!-- Procurement Process -->
    <menuitem id="menu_procurement_process"
              name="Procurement Process"
              parent="menu_nbet_procurement_root"
              sequence="10"/>

    <menuitem id="menu_needs_call"
              name="Needs Calls"
              parent="menu_procurement_process"
              action="action_needs_call"
              sequence="5"/>

    <menuitem id="menu_needs_assessment"
              name="Needs Assessments"
              parent="menu_procurement_process"
              action="action_needs_assessment"
              sequence="10"/>

    <menuitem id="menu_procurement_plan"
              name="Procurement Plans"
              parent="menu_procurement_process"
              action="action_procurement_plan"
              sequence="20"/>

    <menuitem id="menu_procurement_request"
              name="Procurement Requests"
              parent="menu_procurement_process"
              action="action_procurement_request"
              sequence="25"/>

    <menuitem id="menu_bid_evaluation"
              name="Bid Evaluations"
              parent="menu_procurement_process"
              action="action_bid_evaluation"
              sequence="30"/>

    <menuitem id="menu_contract_award"
              name="Contract Awards"
              parent="menu_procurement_process"
              action="action_contract_award"
              sequence="40"/>

    <menuitem id="menu_contract_milestone"
              name="Contract Milestones"
              parent="menu_procurement_process"
              action="action_contract_milestone"
              sequence="45"/>

    <menuitem id="menu_payment_request"
              name="Payment Requests"
              parent="menu_procurement_process"
              action="action_payment_request"
              sequence="50"/>

    <!-- Department Submitter app (separate lightweight entry point) -->
    <menuitem id="menu_submitter_root"
              name="Procurement Needs"
              action="action_my_department_needs"
              web_icon="nbet_procurement,static/description/icon.png"
              sequence="46"
              groups="nbet_procurement.group_procurement_submitter"/>

    <menuitem id="menu_my_department_needs"
              name="My Department Needs"
              parent="menu_submitter_root"
              action="action_my_department_needs"
              sequence="10"
              groups="nbet_procurement.group_procurement_submitter"/>

    <menuitem id="menu_my_department_requests"
              name="My Requests"
              parent="menu_submitter_root"
              action="action_my_department_requests"
              sequence="20"
              groups="nbet_procurement.group_procurement_submitter"/>

    <!-- Configuration Actions -->
    <record id="action_procurement_method" model="ir.actions.act_window">
        <field name="name">Procurement Methods</field>
        <field name="res_model">nbet.procurement.method</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_approval_threshold" model="ir.actions.act_window">
        <field name="name">Approval Thresholds</field>
        <field name="res_model">nbet.approval.threshold</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Configuration -->
    <menuitem id="menu_procurement_config"
              name="Configuration"
              parent="menu_nbet_procurement_root"
              sequence="90"
              groups="nbet_procurement.group_procurement_head"/>

    <menuitem id="menu_procurement_method"
              name="Procurement Methods"
              parent="menu_procurement_config"
              action="action_procurement_method"
              sequence="10"/>

    <menuitem id="menu_approval_threshold"
              name="Approval Thresholds"
              parent="menu_procurement_config"
              action="action_approval_threshold"
              sequence="20"/>

</odoo>
