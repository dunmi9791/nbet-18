<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract Milestone Form -->
    <record id="view_contract_milestone_form" model="ir.ui.view">
        <field name="name">nbet.contract.milestone.form</field>
        <field name="model">nbet.contract.milestone</field>
        <field name="arch" type="xml">
            <form string="Contract Milestone">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'pending'"/>
                    <button name="action_mark_delivered" string="Mark Delivered" type="object"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_verify" string="Complete Verification" type="object"
                            class="btn-primary" invisible="state != 'delivered'"/>
                    <button name="action_request_payment" string="Request Payment" type="object"
                            class="btn-primary" invisible="state not in ('verified', 'payment_requested')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-danger" invisible="state in ('paid', 'cancelled')"/>
                    <button name="action_reset_to_pending" string="Reset to Pending" type="object"
                            invisible="state not in ('delivered', 'verified', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_progress,delivered,verified,payment_requested,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payment_requests" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="payment_request_count == 0">
                            <field name="payment_request_count" widget="statinfo" string="Payment Requests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <h2><field name="title" placeholder="e.g. Phase 1 - Site mobilisation"/></h2>
                    </div>
                    <group>
                        <group string="Contract">
                            <field name="contract_id"/>
                            <field name="vendor_id"/>
                            <field name="sequence"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Value">
                            <field name="amount_basis" widget="radio"/>
                            <field name="percentage" readonly="amount_basis == 'fixed'"/>
                            <field name="amount" readonly="amount_basis == 'percent'"/>
                            <field name="claimed_amount"/>
                            <field name="paid_amount"/>
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="planned_start_date"/>
                            <field name="planned_end_date"/>
                            <field name="actual_completion_date"/>
                        </group>
                        <group string="Verification">
                            <field name="ia_signoff"/>
                            <field name="user_dept_signoff"/>
                            <field name="verification_date"/>
                            <field name="verified_by"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Scope" name="scope">
                            <field name="description" placeholder="What must be delivered for this milestone..."/>
                        </page>
                        <page string="Verification Report" name="verification">
                            <group>
                                <field name="deliverable_attachment" filename="deliverable_attachment_filename"/>
                                <field name="deliverable_attachment_filename" invisible="1"/>
                            </group>
                            <field name="verification_report"
                                   placeholder="Enter inspection/verification findings..."/>
                        </page>
                        <page string="Payment Requests" name="payments">
                            <field name="payment_request_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="request_date"/>
                                    <field name="requested_amount" widget="monetary" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-danger="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Contract Milestone List -->
    <record id="view_contract_milestone_list" model="ir.ui.view">
        <field name="name">nbet.contract.milestone.list</field>
        <field name="model">nbet.contract.milestone</field>
        <field name="arch" type="xml">
            <list string="Contract Milestones"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'paid'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="title"/>
                <field name="contract_id"/>
                <field name="vendor_id" optional="show"/>
                <field name="percentage" optional="show"/>
                <field name="amount" widget="monetary" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="planned_end_date" optional="show"/>
                <field name="actual_completion_date" optional="hide"/>
                <field name="paid_amount" widget="monetary" optional="hide" sum="Paid"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-warning="state in ('in_progress', 'delivered')"
                       decoration-success="state in ('verified', 'paid')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Contract Milestone Search -->
    <record id="view_contract_milestone_search" model="ir.ui.view">
        <field name="name">nbet.contract.milestone.search</field>
        <field name="model">nbet.contract.milestone</field>
        <field name="arch" type="xml">
            <search string="Search Milestones">
                <field name="name"/>
                <field name="title"/>
                <field name="contract_id"/>
                <field name="vendor_id"/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ('paid', 'cancelled'))]"/>
                <filter name="awaiting_verification" string="Awaiting Verification"
                        domain="[('state', '=', 'delivered')]"/>
                <filter name="payable" string="Ready to Claim"
                        domain="[('state', '=', 'verified')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="overdue" string="Past Planned Completion"
                        domain="[('planned_end_date', '&lt;', context_today().strftime('%Y-%m-%d')),
                                 ('state', 'not in', ('paid', 'cancelled'))]"/>
                <group expand="0" string="Group By">
                    <filter name="group_contract" string="Contract" context="{'group_by': 'contract_id'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Contract Milestone Action -->
    <record id="action_contract_milestone" model="ir.actions.act_window">
        <field name="name">Contract Milestones</field>
        <field name="res_model">nbet.contract.milestone</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No milestones yet</p>
            <p>Milestones are defined on a milestone-based contract award and are
               delivered, certified and paid one stage at a time.</p>
        </field>
    </record>

</odoo>
