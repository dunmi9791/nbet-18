<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ── Invoice / Bill / Entry Form: NBET settlement link ───────────── -->
        <record id="view_move_form_nbet_billing" model="ir.ui.view">
            <field name="name">account.move.form.nbet.billing</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <!-- Invoices, bills and credit notes -->
                <xpath expr="//page[@id='other_tab']/group[@id='other_tab_group']"
                       position="inside">
                    <group string="NBET Settlement" name="nbet_settlement_group"
                           groups="nbet_power_billing.group_nbet_billing_officer">
                        <field name="nbet_billing_cycle_id" options="{'no_create': True}"/>
                        <field name="nbet_participant_id" options="{'no_create': True}"/>
                        <field name="nbet_settlement_role"/>
                        <field name="company_currency_id" invisible="1"/>
                        <field name="nbet_amount_settled"/>
                    </group>
                </xpath>
                <!-- Miscellaneous journal entries -->
                <xpath expr="//page[@id='other_tab_entry']/group[@id='other_tab_entry_group']"
                       position="inside">
                    <group string="NBET Settlement" name="nbet_settlement_entry_group"
                           groups="nbet_power_billing.group_nbet_billing_officer">
                        <field name="nbet_billing_cycle_id" options="{'no_create': True}"/>
                        <field name="nbet_participant_id" options="{'no_create': True}"/>
                        <field name="nbet_settlement_role"/>
                    </group>
                </xpath>
            </field>
        </record>

        <!-- ── Invoice / Bill Search: filter and group by cycle ────────────── -->
        <record id="view_account_invoice_filter_nbet_billing" model="ir.ui.view">
            <field name="name">account.move.select.nbet.billing</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='journal_id']" position="after">
                    <field name="nbet_billing_cycle_id" string="NBET Billing Cycle"/>
                </xpath>
                <xpath expr="//filter[@name='late']" position="after">
                    <separator/>
                    <filter string="NBET Settlement Documents" name="nbet_settlement"
                            domain="[('nbet_billing_cycle_id', '!=', False)]"/>
                    <filter string="Not Linked to a Billing Cycle" name="nbet_unlinked"
                            domain="[('nbet_billing_cycle_id', '=', False)]"/>
                </xpath>
                <xpath expr="//filter[@name='group_by_company']" position="after">
                    <separator/>
                    <filter string="NBET Billing Cycle" name="group_nbet_cycle"
                            context="{'group_by': 'nbet_billing_cycle_id'}"/>
                    <filter string="NBET Settlement Role" name="group_nbet_role"
                            context="{'group_by': 'nbet_settlement_role'}"/>
                </xpath>
            </field>
        </record>

        <!-- ── Invoice / Bill List: optional cycle column ──────────────────── -->
        <record id="view_invoice_tree_nbet_billing" model="ir.ui.view">
            <field name="name">account.move.list.nbet.billing</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_invoice_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='status_in_payment']" position="after">
                    <field name="nbet_billing_cycle_id" string="NBET Cycle" optional="hide"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
