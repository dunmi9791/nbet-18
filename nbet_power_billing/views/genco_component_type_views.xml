<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nbet_genco_component_type_list" model="ir.ui.view">
        <field name="name">nbet.genco.component.type.list</field>
        <field name="model">nbet.genco.component.type</field>
        <field name="arch" type="xml">
            <list string="Component Types" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_nbet_genco_component_type_form" model="ir.ui.view">
        <field name="name">nbet.genco.component.type.form</field>
        <field name="model">nbet.genco.component.type</field>
        <field name="arch" type="xml">
            <form string="Component Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nbet_genco_component_type" model="ir.actions.act_window">
        <field name="name">Genco Component Types</field>
        <field name="res_model">nbet.genco.component.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
