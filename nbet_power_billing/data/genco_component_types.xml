        <record id="component_type_capacity" model="nbet.genco.component.type">
            <field name="name">Capacity Charge</field>
            <field name="code">capacity</field>
            <field name="description">Standard capacity payment component.</field>
        </record>
        <record id="component_type_energy" model="nbet.genco.component.type">
            <field name="name">Energy Charge</field>
            <field name="code">energy</field>
            <field name="description">Energy payment component (fuel + non-fuel O&amp;M).</field>
        </record>
        <record id="component_type_fx" model="nbet.genco.component.type">
            <field name="name">FX Adjustment</field>
            <field name="code">fx</field>
            <field name="description">Foreign exchange rate adjustment component.</field>
        </record>
        <record id="component_type_gas" model="nbet.genco.component.type">
            <field name="name">Gas / Fuel Component</field>
            <field name="code">gas</field>
