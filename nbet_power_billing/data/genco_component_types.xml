            <field name="code">adjustment</field>
            <field name="description">General adjustments or penalties.</field>
        </record>
        <record id="component_type_import_charge" model="nbet.genco.component.type">
            <field name="name">Import Liability Charge</field>
            <field name="code">import_charge</field>
            <field name="description">Charge related to imported power liability.</field>
        </record>
        <record id="component_type_other" model="nbet.genco.component.type">
            <field name="name">Other</field>
            <field name="code">other</field>
            <field name="description">Miscellaneous components.</field>
        </record>
