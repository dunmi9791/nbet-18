<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!--
    NBET letterhead for QWeb PDF reports.

    Registered as a selectable document layout (Settings > General Settings >
    Document Layout), so it applies to every report that calls
    web.external_layout — including the treasury payment vouchers, purchase
    orders and invoices — without touching those reports individually.

    Modelled on web.external_layout_standard so it keeps the same contract:
    company address block, `layout_document_title`, and the report_footer /
    page-number footer.
-->

<template id="external_layout_nbet">
    <div t-attf-class="header o_nbet_report_header o_company_#{company.id}_layout">
        <div class="d-flex justify-content-between align-items-end pb-2">
            <img t-if="company.logo" class="o_company_logo_small"
                 t-att-src="image_data_uri(company.logo)" alt="Logo"/>
            <div t-if="company.report_header" t-field="company.report_header"
                 class="o_company_tagline mw-50 text-end small"/>
        </div>
        <!-- Navy rule with a lime leader, the site's masthead device -->
        <div class="o_nbet_report_rule"/>

        <div class="row mt-2">
            <div class="col-7" name="company_address">
                <ul class="list-unstyled small" name="company_address_list">
                    <li t-if="company.is_company_details_empty">
                        <span t-field="company.partner_id"
                              t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                    </li>
                    <li t-else="">
                        <span t-field="company.company_details"/>
                    </li>
                    <li t-if="forced_vat">
                        <t t-esc="company.country_id.vat_label or 'Tax ID'">Tax ID</t>:
                        <span t-esc="forced_vat"/>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div t-attf-class="article o_nbet_report_body o_report_layout_standard o_table_standard o_company_#{company.id}_layout"
         t-att-data-oe-model="o and o._name"
         t-att-data-oe-id="o and o.id"
         t-att-data-oe-lang="o and o.env.context.get('lang')">
        <t t-call="web.address_layout"/>
        <h2 t-out="layout_document_title"/>
        <t t-out="0"/>
    </div>

    <div t-attf-class="footer o_nbet_report_footer o_company_#{company.id}_layout {{report_type != 'pdf' and 'mt-auto'}}">
        <div class="o_nbet_report_rule mb-1"/>
        <div class="o_footer_content d-flex">
            <div class="flex-grow-1 text-start me-2 small" t-field="company.report_footer"/>
            <div class="text-end text-muted small">
                <div t-if="report_type == 'pdf' and display_name_in_footer" t-out="o.name"/>
                <div t-if="report_type == 'pdf'" class="text-nowrap">
                    Page <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </div>
</template>

<record id="report_layout_nbet" model="report.layout">
    <field name="name">NBET</field>
    <field name="sequence">1</field>
    <field name="view_id" ref="nbet_brand.external_layout_nbet"/>
</record>

</odoo>
