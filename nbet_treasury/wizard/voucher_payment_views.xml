<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_voucher_payment_form" model="ir.ui.view">
        <field name="name">nbet.voucher.payment.form</field>
        <field name="model">nbet.voucher.payment</field>
        <field name="arch" type="xml">
            <form string="Register Voucher Payments">
                <group>
                    <group>
                        <field name="payment_journal_id"/>
                        <field name="payment_date"/>
                        <field name="payment_reference"
                               placeholder="e.g. the bank instruction number"/>
                    </group>
                    <group>
                        <field name="voucher_count" string="Vouchers"/>
                        <field name="total_amount" widget="monetary"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <field name="voucher_ids">
                    <list string="Vouchers">
                        <field name="name"/>
                        <field name="voucher_type"/>
                        <field name="partner_id"/>
                        <field name="description"/>
                        <field name="amount" widget="monetary" sum="Total"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="state"/>
                    </list>
                </field>
                <footer>
                    <button name="action_register_payments" type="object"
                            string="Register Payments" class="btn-primary"
                            confirm="This posts a payment for every voucher listed and marks them paid. Continue?"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_voucher_payment" model="ir.actions.act_window">
        <field name="name">Register Payments</field>
        <field name="res_model">nbet.voucher.payment</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_nbet_payment_voucher"/>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('group_treasury_manager'))]"/>
    </record>

</odoo>
