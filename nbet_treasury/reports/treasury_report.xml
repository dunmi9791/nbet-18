<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_treasury_report" model="report.paperformat">
        <field name="name">A4 Landscape - Treasury Report</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">28</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_treasury" model="ir.actions.report">
        <field name="name">Treasury Report</field>
        <field name="model">nbet.treasury.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nbet_treasury.report_treasury</field>
        <field name="report_file">treasury_report</field>
        <field name="print_report_name">'Treasury Report - %s to %s' % (object.date_from, object.date_to)</field>
        <field name="paperformat_id" ref="paperformat_treasury_report"/>
    </record>

    <template id="report_treasury_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center">NIGERIAN BULK ELECTRICITY TRADING PLC (NBET)</h2>
                <h3 class="text-center">TREASURY REPORT</h3>
                <p class="text-center">
                    <strong>Period:</strong>
                    <span t-field="doc.date_from"/> &#8212; <span t-field="doc.date_to"/>
                    &#160;|&#160;
                    <strong>Broken down by:</strong> <span t-field="doc.period_type"/>
                    &#160;|&#160;
                    <strong>Entries:</strong> <span t-field="doc.target_move"/>
                </p>
                <p class="text-center text-muted">
                    All amounts in <span t-field="doc.currency_id.name"/>.
                    Generated on <span t-field="doc.generated_on"/>.
                </p>

                <h4 class="mt-4">Bank Account Balances</h4>
                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Bank Account</th>
                            <th>Account Number</th>
                            <th class="text-end">Opening</th>
                            <th class="text-end">Inflow</th>
                            <th class="text-end">Outflow</th>
                            <th class="text-end">Net</th>
                            <th class="text-end">Closing</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids" t-as="line">
                            <td><span t-field="line.journal_code"/></td>
                            <td><span t-field="line.journal_name"/></td>
                            <td><span t-field="line.acc_number"/></td>
                            <td class="text-end"><span t-field="line.opening_balance"/></td>
                            <td class="text-end"><span t-field="line.inflow"/></td>
                            <td class="text-end"><span t-field="line.outflow"/></td>
                            <td class="text-end"><span t-field="line.net_movement"/></td>
                            <td class="text-end"><strong><span t-field="line.closing_balance"/></strong></td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">TOTAL</th>
                            <th class="text-end"><span t-field="doc.total_opening"/></th>
                            <th class="text-end"><span t-field="doc.total_inflow"/></th>
                            <th class="text-end"><span t-field="doc.total_outflow"/></th>
                            <th class="text-end"><span t-field="doc.total_net"/></th>
                            <th class="text-end"><span t-field="doc.total_closing"/></th>
                        </tr>
                    </tfoot>
                </table>

                <h4 class="mt-4">Inflow / Outflow by Period</h4>
                <t t-foreach="doc.line_ids" t-as="line">
                    <t t-set="periods" t-value="doc.period_line_ids.filtered(lambda p: p.journal_id == line.journal_id).sorted('sequence')"/>
                    <div class="mt-3" style="page-break-inside: avoid;">
                        <h5>
                            <span t-field="line.journal_name"/>
                            <small class="text-muted" t-if="line.acc_number">
                                (<span t-field="line.acc_number"/>)
                            </small>
                        </h5>
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr>
                                    <th>Period</th>
                                    <th class="text-end">Opening</th>
                                    <th class="text-end">Inflow</th>
                                    <th class="text-end">Outflow</th>
                                    <th class="text-end">Net</th>
                                    <th class="text-end">Closing</th>
                                    <th class="text-end">Txns</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="periods" t-as="period">
                                    <td><span t-field="period.period_label"/></td>
                                    <td class="text-end"><span t-field="period.opening_balance"/></td>
                                    <td class="text-end"><span t-field="period.inflow"/></td>
                                    <td class="text-end"><span t-field="period.outflow"/></td>
                                    <td class="text-end"><span t-field="period.net_movement"/></td>
                                    <td class="text-end"><span t-field="period.closing_balance"/></td>
                                    <td class="text-end"><span t-field="period.move_count"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th class="text-end">TOTAL</th>
                                    <th class="text-end"><span t-field="line.opening_balance"/></th>
                                    <th class="text-end"><span t-field="line.inflow"/></th>
                                    <th class="text-end"><span t-field="line.outflow"/></th>
                                    <th class="text-end"><span t-field="line.net_movement"/></th>
                                    <th class="text-end"><span t-field="line.closing_balance"/></th>
                                    <th class="text-end"><span t-field="line.move_count"/></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>

    <template id="report_treasury">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="nbet_treasury.report_treasury_document"/>
            </t>
        </t>
    </template>

</odoo>
