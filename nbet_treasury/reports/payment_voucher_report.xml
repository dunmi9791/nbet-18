<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_payment_voucher" model="ir.actions.report">
        <field name="name">Payment Voucher</field>
        <field name="model">nbet.payment.voucher</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nbet_treasury.report_payment_voucher</field>
        <field name="report_file">payment_voucher_report</field>
        <field name="print_report_name">'Payment Voucher - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_nbet_payment_voucher"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_payment_voucher_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 class="text-center">NIGERIAN BULK ELECTRICITY TRADING PLC (NBET)</h2>
                <h3 class="text-center">
                    <t t-if="doc.voucher_type == 'tax'">TAX REMITTANCE VOUCHER</t>
                    <t t-elif="doc.voucher_type == 'payroll'">SALARY PAYMENT VOUCHER</t>
                    <t t-else="">PAYMENT VOUCHER</t>
                </h3>

                <table class="table table-sm table-borderless mt-4" style="width:100%;">
                    <tr>
                        <td>
                            <strong t-if="doc.payment_request_id">Payment Request:</strong>
                            <strong t-else="">Source Document:</strong>
                        </td>
                        <td>
                            <span t-if="doc.payment_request_id" t-field="doc.payment_request_id.name"/>
                            <span t-else="" t-esc="doc.schedule_id._source_document_name()"/>
                        </td>
                        <td><strong>Prepared By:</strong></td>
                        <td><span t-field="doc.generated_by_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Voucher Number:</strong></td>
                        <td><span t-field="doc.name"/></td>
                        <td><strong>Prepared On:</strong></td>
                        <td><span t-field="doc.generated_on"/></td>
                    </tr>
                    <tr>
                        <td><strong>Transaction Ref:</strong></td>
                        <td><span t-field="doc.transaction_reference"/></td>
                        <td><strong>Status:</strong></td>
                        <td><span t-field="doc.state"/></td>
                    </tr>
                    <tr>
                        <td>
                            <strong t-if="doc.contract_award_id">Contract Award:</strong>
                            <strong t-else="">Payment Schedule:</strong>
                        </td>
                        <td>
                            <span t-if="doc.contract_award_id" t-field="doc.contract_award_id.name"/>
                            <span t-else="" t-field="doc.schedule_id.name"/>
                        </td>
                        <td><strong>Payment Method:</strong></td>
                        <td><span t-field="doc.schedule_id.payment_method"/></td>
                    </tr>
                    <tr t-if="doc.state == 'paid'">
                        <td><strong>Payment Reference:</strong></td>
                        <td><span t-field="doc.payment_reference"/></td>
                        <td><strong>Paid On:</strong></td>
                        <td>
                            <span t-field="doc.payment_date"/>
                            <t t-if="doc.payment_journal_id">
                                (<span t-field="doc.payment_journal_id.name"/>)
                            </t>
                        </td>
                    </tr>
                </table>

                <h4 class="mt-3">
                    <t t-if="doc.voucher_type == 'tax'">Tax Body Details</t>
                    <t t-elif="doc.voucher_type == 'payroll'">Employee Details</t>
                    <t t-else="">Vendor Details</t>
                </h4>
                <table class="table table-sm table-bordered" style="width:100%;">
                    <tr>
                        <td style="width:25%"><strong>Name</strong></td>
                        <td><span t-field="doc.partner_id.name"/></td>
                    </tr>
                    <tr>
                        <td><strong>Address</strong></td>
                        <td><span t-field="doc.partner_id" t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/></td>
                    </tr>
                    <tr>
                        <td><strong>TIN / VAT No.</strong></td>
                        <td><span t-field="doc.partner_vat"/></td>
                    </tr>
                    <tr>
                        <td><strong>Phone / Email</strong></td>
                        <td>
                            <span t-field="doc.partner_phone"/>
                            <t t-if="doc.partner_email"> / <span t-field="doc.partner_email"/></t>
                        </td>
                    </tr>
                    <tr t-if="doc.bank_account">
                        <td><strong>Bank Account</strong></td>
                        <td><span t-field="doc.bank_account"/></td>
                    </tr>
                </table>

                <h4 class="mt-3">Payment Particulars</h4>
                <table class="table table-sm table-bordered" style="width:100%;">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-field="doc.description"/></td>
                            <td class="text-end">
                                <span t-field="doc.amount"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>TOTAL</th>
                            <th class="text-end">
                                <span t-field="doc.amount"
                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                            </th>
                        </tr>
                    </tfoot>
                </table>

                <!-- Gross / deduction breakdown for context -->
                <table class="table table-sm table-bordered" style="width:100%;">
                    <tr>
                        <td style="width:50%"><strong>Gross Payment Request Amount</strong></td>
                        <td class="text-end">
                            <span t-field="doc.schedule_id.amount"
                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                        </td>
                    </tr>
                    <tr t-foreach="doc.schedule_id.tax_line_ids" t-as="tax">
                        <td>Less: <span t-field="tax.name"/> (<span t-field="tax.tax_body_id.name"/>)</td>
                        <td class="text-end">
                            <span t-field="tax.amount"
                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                        </td>
                    </tr>
                    <tr>
                        <td><strong>Net Payable to Vendor</strong></td>
                        <td class="text-end">
                            <strong><span t-field="doc.schedule_id.net_amount"
                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/></strong>
                        </td>
                    </tr>
                </table>
                <table class="table table-sm table-borderless mt-4" style="width:100%;">
                    <tr>
                        <td style="width:33%;">
                            <div style="border-top:1px solid #000; padding-top:3px;">
                                <strong>Prepared By</strong><br/>
                                <span t-field="doc.generated_by_id.name"/><br/>
                                <span style="font-size:8px;" t-field="doc.generated_on"/>
                            </div>
                        </td>
                        <td style="width:33%;">
                            <div style="border-top:1px solid #000; padding-top:3px;">
                                <strong>Audit Review</strong><br/>
                                <span t-field="doc.schedule_id.audit_reviewer_id.name"/><br/>
                                <span style="font-size:8px;" t-field="doc.schedule_id.audit_review_date"/>
                            </div>
                        </td>
                        <td style="width:33%;">
                            <div style="border-top:1px solid #000; padding-top:3px;">
                                <strong>Audit Approval</strong><br/>
                                <span t-field="doc.schedule_id.auditor_id.name"/><br/>
                                <span style="font-size:8px;" t-field="doc.schedule_id.audit_date"/>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="row mt-4">
                    <div class="col-12">
                        <p style="font-size: 8px;" class="text-muted">
                            This voucher was generated electronically by the NBET Treasury system.
                        </p>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="report_payment_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="nbet_treasury.report_payment_voucher_document"/>
            </t>
        </t>
    </template>

</odoo>
