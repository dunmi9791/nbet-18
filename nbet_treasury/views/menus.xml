<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu -->
    <menuitem id="menu_nbet_treasury_root"
              name="Treasury"
              action="action_treasury_dashboard"
              web_icon="nbet_treasury,static/description/icon.png"
              sequence="46"/>

    <!-- Dashboard -->
    <menuitem id="menu_treasury_dashboard"
              name="Dashboard"
              parent="menu_nbet_treasury_root"
              action="action_treasury_dashboard"
              sequence="1"/>

    <!-- Payment Operations -->
    <menuitem id="menu_treasury_operations"
              name="Payment Operations"
              parent="menu_nbet_treasury_root"
              sequence="10"/>

    <!-- Payment Schedule -->
    <menuitem id="menu_payment_schedule"
              name="Payment Schedule"
              parent="menu_treasury_operations"
              action="action_payment_schedule"
              sequence="10"/>

    <!-- Audited / Ready to Pay -->
    <record id="action_payment_schedule_approved" model="ir.actions.act_window">
        <field name="name">Ready to Pay</field>
        <field name="res_model">nbet.payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'audited')]</field>
    </record>

    <menuitem id="menu_payment_schedule_approved"
              name="Ready to Pay"
              parent="menu_treasury_operations"
              action="action_payment_schedule_approved"
              sequence="20"/>

    <!-- Completed Payments -->
    <record id="action_payment_schedule_paid" model="ir.actions.act_window">
        <field name="name">Completed Payments</field>
        <field name="res_model">nbet.payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'paid')]</field>
    </record>

    <menuitem id="menu_payment_schedule_paid"
              name="Completed Payments"
              parent="menu_treasury_operations"
              action="action_payment_schedule_paid"
              sequence="30"/>

    <!-- On Hold -->
    <record id="action_payment_schedule_on_hold" model="ir.actions.act_window">
        <field name="name">On Hold</field>
        <field name="res_model">nbet.payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'on_hold')]</field>
    </record>

    <menuitem id="menu_payment_schedule_on_hold"
              name="On Hold"
              parent="menu_treasury_operations"
              action="action_payment_schedule_on_hold"
              sequence="40"/>

</odoo>
