<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Root Menu -->
    <menuitem id="menu_nbet_treasury_root"
              name="Treasury"
              action="action_treasury_dashboard"
              web_icon="nbet_treasury,static/description/icon.png"
              sequence="46"/>

    <!-- Dashboard -->
    <menuitem id="menu_treasury_dashboard"
              name="Dashboard"
              parent="menu_nbet_treasury_root"
              action="action_treasury_dashboard"
              sequence="1"/>

    <!-- Payment Operations -->
    <menuitem id="menu_treasury_operations"
              name="Payment Operations"
              parent="menu_nbet_treasury_root"
              sequence="10"/>

    <!-- Payment Schedule -->
    <menuitem id="menu_payment_schedule"
              name="Payment Schedule"
              parent="menu_treasury_operations"
              action="action_payment_schedule"
              sequence="10"/>

    <!-- Payment Vouchers -->
    <menuitem id="menu_payment_voucher"
              name="Payment Vouchers"
              parent="menu_treasury_operations"
              action="action_payment_voucher"
              sequence="15"/>

    <!-- Audit -->
    <menuitem id="menu_treasury_audit"
              name="Audit"
              parent="menu_nbet_treasury_root"
              groups="nbet_treasury.group_auditor"
              sequence="20"/>

    <record id="action_payment_schedule_audit" model="ir.actions.act_window">
        <field name="name">Payments for Audit</field>
        <field name="res_model">nbet.payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ('audit_pending', 'audit_reviewed'))]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing awaiting audit</p>
            <p>Payment requests appear here once the assigned finance officer has
               generated the vouchers and forwarded them to audit.</p>
        </field>
    </record>

    <menuitem id="menu_payment_schedule_audit"
              name="Payments for Audit"
              parent="menu_treasury_audit"
              action="action_payment_schedule_audit"
              sequence="10"/>

    <menuitem id="menu_payment_voucher_audit"
              name="Vouchers for Audit"
              parent="menu_treasury_audit"
              action="action_payment_voucher_audit"
              sequence="20"/>

    <menuitem id="menu_payment_voucher_to_pay"
              name="Vouchers to Pay"
              parent="menu_treasury_operations"
              action="action_payment_voucher_to_pay"
              groups="nbet_treasury.group_treasury_manager"
              sequence="18"/>

    <!-- Configuration -->
    <menuitem id="menu_treasury_configuration"
              name="Configuration"
              parent="menu_nbet_treasury_root"
              groups="nbet_treasury.group_treasury_manager"
              sequence="90"/>

    <menuitem id="menu_tax_rule"
              name="Tax Rules"
              parent="menu_treasury_configuration"
              action="action_tax_rule"
              sequence="10"/>

    <!-- Audited / Ready to Pay -->
    <record id="action_payment_schedule_approved" model="ir.actions.act_window">
        <field name="name">Ready to Pay</field>
        <field name="res_model">nbet.payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'audited')]</field>
    </record>

    <menuitem id="menu_payment_schedule_approved"
              name="Ready to Pay"
              parent="menu_treasury_operations"
              action="action_payment_schedule_approved"
              sequence="20"/>

    <!-- Completed Payments -->
    <record id="action_payment_schedule_paid" model="ir.actions.act_window">
        <field name="name">Completed Payments</field>
        <field name="res_model">nbet.payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'paid')]</field>
    </record>

    <menuitem id="menu_payment_schedule_paid"
              name="Completed Payments"
              parent="menu_treasury_operations"
              action="action_payment_schedule_paid"
              sequence="30"/>

    <!-- On Hold -->
    <record id="action_payment_schedule_on_hold" model="ir.actions.act_window">
        <field name="name">On Hold</field>
        <field name="res_model">nbet.payment.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'on_hold')]</field>
    </record>

    <menuitem id="menu_payment_schedule_on_hold"
              name="On Hold"
              parent="menu_treasury_operations"
              action="action_payment_schedule_on_hold"
              sequence="40"/>

</odoo>
