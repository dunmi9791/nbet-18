<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_nbet_treasury" model="ir.module.category">
        <field name="name">NBET Treasury</field>
        <field name="description">NBET Treasury Management</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_treasury_user" model="res.groups">
        <field name="name">Treasury Officer</field>
        <field name="category_id" ref="module_category_nbet_treasury"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and schedule payments.</field>
    </record>

    <record id="group_treasury_manager" model="res.groups">
        <field name="name">Treasury Manager</field>
        <field name="category_id" ref="module_category_nbet_treasury"/>
        <field name="implied_ids" eval="[(4, ref('group_treasury_user'))]"/>
        <field name="comment">Can process audited payments and manage all treasury operations.</field>
    </record>

    <!-- Payment approval authorities (segregation of duties) -->
    <record id="group_cfo" model="res.groups">
        <field name="name">Chief Financial Officer (CFO)</field>
        <field name="category_id" ref="module_category_nbet_treasury"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">First approval authority in the payment approval chain.</field>
    </record>

    <record id="group_finance_manager" model="res.groups">
        <field name="name">Finance Manager</field>
        <field name="category_id" ref="module_category_nbet_treasury"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Second approval authority; approves after the CFO.</field>
    </record>

    <record id="group_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="module_category_nbet_treasury"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Final sign-off authority; audits before a payment is processed.</field>
    </record>

    <!-- Sequences -->
    <record id="seq_payment_schedule" model="ir.sequence">
        <field name="name">Payment Schedule</field>
        <field name="code">nbet.payment.schedule</field>
        <field name="prefix">PS/%(year)s/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_payment_voucher" model="ir.sequence">
        <field name="name">Payment Voucher</field>
        <field name="code">nbet.payment.voucher</field>
        <field name="prefix">PV/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <record id="seq_payment_transaction" model="ir.sequence">
        <field name="name">Payment Transaction Reference</field>
        <field name="code">nbet.payment.transaction</field>
        <field name="prefix">TXN/%(year)s/</field>
        <field name="padding">5</field>
    </record>

</odoo>
