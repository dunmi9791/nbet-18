<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_nbet_payment_advice_form_treasury" model="ir.ui.view">
        <field name="name">nbet.payment.advice.form.treasury</field>
        <field name="model">nbet.payment.advice</field>
        <field name="inherit_id" ref="nbet_power_billing.view_nbet_payment_advice_form"/>
        <field name="arch" type="xml">
            <button name="action_print_advice" position="before">
                <button name="action_send_to_treasury" type="object"
                        string="Send to Treasury" class="btn-primary"
                        invisible="state != 'md_approved'"
                        groups="nbet_power_billing.group_nbet_settlement_manager"/>
            </button>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_payment_schedule" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o"
                        invisible="not payment_schedule_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="schedule_state"/></span>
                        <span class="o_stat_text">Treasury</span>
                    </div>
                </button>
                <button name="action_view_vouchers" type="object"
                        class="oe_stat_button" icon="fa-files-o"
                        invisible="voucher_count == 0">
                    <field name="voucher_count" widget="statinfo" string="Vouchers"/>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
