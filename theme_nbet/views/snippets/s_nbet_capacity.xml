<?xml version="1.0" encoding="utf-8"?>
<odoo>

<template id="s_nbet_capacity" name="NBET Capacity Figures">
    <!--
        Figures count up from zero when the block scrolls into view
        (static/src/js/nbet_counter.js). Edit the headline number through
        data-target-value; the visible text is regenerated by the widget.
    -->
    <section class="s_nbet_capacity pt64 pb64 o_cc o_cc5 o_colored_level">
        <div class="container">
            <div class="row text-center">
                <div class="col-md-4 s_nbet_counter">
                    <div>
                        <span class="s_nbet_counter_value" data-target-value="13014" data-duration="2000">13,014</span>
                        <span class="s_nbet_counter_unit">MW</span>
                    </div>
                    <p class="s_nbet_counter_label">Installed Capacity</p>
                </div>
                <div class="col-md-4 s_nbet_counter">
                    <div>
                        <span class="s_nbet_counter_value" data-target-value="8457" data-duration="2000">8,457</span>
                        <span class="s_nbet_counter_unit">MW</span>
                    </div>
                    <p class="s_nbet_counter_label">Available Capacity</p>
                </div>
                <div class="col-md-4 s_nbet_counter">
                    <div>
                        <span class="s_nbet_counter_value" data-target-value="4820" data-duration="2000">4,820</span>
                        <span class="s_nbet_counter_unit">MW</span>
                    </div>
                    <p class="s_nbet_counter_label">Average Generation</p>
                </div>
            </div>
        </div>
    </section>
</template>

</odoo>
