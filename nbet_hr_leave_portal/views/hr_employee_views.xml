<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add a "Grant Portal Access" button to the employee form header -->
    <record id="view_employee_form_leave_portal" model="ir.ui.view">
        <field name="name">hr.employee.form.leave.portal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_grant_leave_portal_access"
                        type="object"
                        string="Grant Portal Access"
                        class="btn-secondary"
                        groups="hr.group_hr_user"/>
            </xpath>
        </field>
    </record>

</odoo>
