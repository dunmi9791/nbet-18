<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================ -->
    <!-- Portal home: "Time Off" entry with request counter           -->
    <!-- ============================================================ -->
    <template id="portal_my_home_leave" name="Portal My Home: Time Off"
              inherit_id="portal.portal_my_home" priority="40">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/nbet_hr_leave_portal/static/src/img/leave.svg'"/>
                <t t-set="title">Time Off</t>
                <t t-set="text">Request leave and track your requests</t>
                <t t-set="url" t-value="'/my/leaves'"/>
                <t t-set="placeholder_count" t-value="'leave_count'"/>
            </t>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- Breadcrumb submenu shared by all leave portal pages          -->
    <!-- ============================================================ -->
    <template id="portal_leave_breadcrumbs" name="Portal Leave Breadcrumbs"
              inherit_id="portal.portal_breadcrumbs" priority="40">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name in ('leave', 'leave_new', 'leave_allocation')"
                class="breadcrumb-item">
                <a t-if="page_name != 'leave'" href="/my/leaves">Time Off</a>
                <span t-else="">Time Off</span>
            </li>
            <li t-if="page_name == 'leave_new'" class="breadcrumb-item active">
                New Request
            </li>
            <li t-if="page_name == 'leave_allocation'" class="breadcrumb-item active">
                Remaining Days
            </li>
        </xpath>
    </template>

    <!-- ============================================================ -->
    <!-- No employee linked to the portal user                        -->
    <!-- ============================================================ -->
    <template id="portal_leave_no_employee" name="Portal: No Employee">
        <t t-call="portal.portal_layout">
            <div class="alert alert-warning mt16" role="alert">
                <h5 class="alert-heading">No employee record found</h5>
                <p class="mb-0">
                    Your portal account is not linked to an employee yet, so there
                    is no time off information to display. Please contact your HR
                    administrator to have your employee record connected to your
                    account.
                </p>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- List of my leave requests                                    -->
    <!-- ============================================================ -->
    <template id="portal_my_leaves" name="My Time Off">
        <t t-call="portal.portal_layout">
            <div class="row mb-3 align-items-center">
                <div class="col">
                    <h3 class="mb-0">Time Off</h3>
                </div>
                <div class="col-auto text-end">
                    <a href="/my/leave/new" class="btn btn-primary">
                        <i class="fa fa-plus me-1"/> New Time Off Request
                    </a>
                    <a href="/my/leaves/allocations" class="btn btn-outline-secondary ms-2">
                        <i class="fa fa-pie-chart me-1"/> Remaining Days
                    </a>
                </div>
            </div>

            <div class="row mb-2" t-if="leaves">
                <div class="col-auto ms-auto">
                    <div class="btn-group btn-group-sm" role="group">
                        <t t-foreach="searchbar_sortings" t-as="option">
                            <a t-attf-href="/my/leaves?sortby=#{option}"
                               t-attf-class="btn btn-outline-secondary #{sortby == option and 'active' or ''}">
                                <t t-esc="searchbar_sortings[option]['label']"/>
                            </a>
                        </t>
                    </div>
                </div>
            </div>

            <t t-if="not leaves">
                <div class="alert alert-info" role="alert">
                    You have not submitted any time off requests yet.
                </div>
            </t>

            <t t-if="leaves">
                <div class="o_portal_my_doc_table">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>From</th>
                                <th>To</th>
                                <th class="text-end">Days</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="leaves" t-as="leave">
                                <td>
                                    <a t-attf-href="/my/leave/#{leave.id}">
                                        <t t-esc="leave.holiday_status_id.display_name"/>
                                    </a>
                                </td>
                                <td><span t-field="leave.request_date_from"/></td>
                                <td><span t-field="leave.request_date_to"/></td>
                                <td class="text-end">
                                    <t t-esc="leave.number_of_days"/>
                                </td>
                                <td>
                                    <span t-attf-class="badge text-bg-#{state_badges.get(leave.state, 'secondary')}">
                                        <t t-esc="state_labels.get(leave.state, leave.state)"/>
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="o_portal_pager text-center" t-if="pager">
                    <t t-call="portal.pager"/>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Remaining allocation days                                    -->
    <!-- ============================================================ -->
    <template id="portal_my_allocations" name="My Remaining Days">
        <t t-call="portal.portal_layout">
            <div class="row mb-3">
                <div class="col">
                    <h3>Remaining Days</h3>
                    <p class="text-muted">
                        Leave balances for <strong t-esc="employee.name"/>.
                    </p>
                </div>
            </div>

            <t t-if="not allocation_data">
                <div class="alert alert-info" role="alert">
                    You currently have no allocated leave types.
                </div>
            </t>

            <t t-if="allocation_data">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Time Off Type</th>
                            <th class="text-end">Allocated</th>
                            <th class="text-end">Taken</th>
                            <th class="text-end">Remaining</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="allocation_data" t-as="alloc">
                            <td><t t-esc="alloc['name']"/></td>
                            <td class="text-end"><t t-esc="alloc['allocated']"/></td>
                            <td class="text-end"><t t-esc="alloc['taken']"/></td>
                            <td class="text-end">
                                <strong t-esc="alloc['remaining']"/>
                                <small t-if="alloc['virtual_remaining'] != alloc['remaining']"
                                       class="text-muted d-block">
                                    (<t t-esc="alloc['virtual_remaining']"/> incl. pending)
                                </small>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </t>

            <a href="/my/leaves" class="btn btn-outline-secondary">
                <i class="fa fa-arrow-left me-1"/> Back to Time Off
            </a>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- New leave request form                                       -->
    <!-- ============================================================ -->
    <template id="portal_leave_new" name="New Time Off Request">
        <t t-call="portal.portal_layout">
            <div class="row">
                <div class="col-lg-8">
                    <h3>New Time Off Request</h3>

                    <div t-if="error" class="alert alert-danger" role="alert">
                        <t t-esc="error"/>
                    </div>

                    <form action="/my/leave/new" method="post" class="mt-3">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                        <div class="mb-3">
                            <label class="form-label" for="holiday_status_id">Time Off Type</label>
                            <select name="holiday_status_id" id="holiday_status_id"
                                    class="form-select" required="required">
                                <option value="">Select a type...</option>
                                <t t-foreach="leave_types" t-as="lt">
                                    <option t-att-value="lt.id"
                                            t-att-selected="form.get('holiday_status_id') == str(lt.id) or None">
                                        <t t-esc="lt.display_name"/>
                                    </option>
                                </t>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="request_date_from">From</label>
                                <input type="date" name="request_date_from"
                                       id="request_date_from" class="form-control"
                                       t-att-value="form.get('request_date_from')"
                                       required="required"/>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="request_date_to">To</label>
                                <input type="date" name="request_date_to"
                                       id="request_date_to" class="form-control"
                                       t-att-value="form.get('request_date_to')"
                                       required="required"/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="name">Description (optional)</label>
                            <textarea name="name" id="name" class="form-control" rows="3"
                                      t-esc="form.get('name')"/>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-paper-plane me-1"/> Submit Request
                        </button>
                        <a href="/my/leaves" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- Single leave request detail                                  -->
    <!-- ============================================================ -->
    <template id="portal_leave_detail" name="Time Off Request">
        <t t-call="portal.portal_layout">
            <div t-if="message == 'created'" class="alert alert-success" role="alert">
                Your time off request has been submitted.
            </div>
            <div t-if="message == 'cancel_error'" class="alert alert-danger" role="alert">
                This request can no longer be cancelled.
            </div>

            <div class="row mb-3">
                <div class="col d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">
                        <t t-esc="leave.holiday_status_id.display_name"/>
                    </h3>
                    <span t-attf-class="badge text-bg-#{state_badges.get(leave.state, 'secondary')}">
                        <t t-esc="state_labels.get(leave.state, leave.state)"/>
                    </span>
                </div>
            </div>

            <table class="table">
                <tr>
                    <th style="width: 30%;">Employee</th>
                    <td><t t-esc="leave.employee_id.name"/></td>
                </tr>
                <tr>
                    <th>From</th>
                    <td><span t-field="leave.request_date_from"/></td>
                </tr>
                <tr>
                    <th>To</th>
                    <td><span t-field="leave.request_date_to"/></td>
                </tr>
                <tr>
                    <th>Duration</th>
                    <td><t t-esc="leave.number_of_days"/> day(s)</td>
                </tr>
                <tr t-if="leave.name">
                    <th>Description</th>
                    <td><t t-esc="leave.name"/></td>
                </tr>
            </table>

            <div class="mt-3">
                <a href="/my/leaves" class="btn btn-outline-secondary">
                    <i class="fa fa-arrow-left me-1"/> Back to Time Off
                </a>
                <form t-if="can_cancel" t-attf-action="/my/leave/#{leave.id}/cancel"
                      method="post" class="d-inline">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <button type="submit" class="btn btn-outline-danger ms-2"
                            onclick="return confirm('Cancel this time off request?');">
                        <i class="fa fa-times me-1"/> Cancel Request
                    </button>
                </form>
            </div>
        </t>
    </template>

</odoo>
